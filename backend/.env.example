################################################################################
# HYBRID INTELLIGENCE BACKEND - ENVIRONMENT CONFIGURATION
#
# Copy this file to .env and fill in actual values
# DO NOT commit .env to version control
#
# Required Vars (🔴): Must be set in production
# Conditional Vars (🟡): Required for specific features
# Optional Vars (🟢): Safe to leave as defaults
################################################################################

################################################################################
# CORE APPLICATION 🟢
################################################################################
ENV=development
DEBUG=true
APP_NAME=Hybrid Intelligence Backend
JWT_SECRET_KEY=dev-secret-key-change-this-in-production

################################################################################
# DATABASE - MONGODB 🔴
################################################################################
MONGO_URL=mongodb://localhost:27017
DB_NAME=hybrid_intelligence

################################################################################
# STRIPE BILLING 🟡 (required for real payments)
# Get test keys: https://dashboard.stripe.com/apikeys (use sk_test_...)
# Get product/price IDs: https://dashboard.stripe.com/products
################################################################################
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

################################################################################
# EMAIL - RESEND 🟡 (required for password reset, invites)
# Get key: https://resend.com/api-keys
################################################################################
RESEND_API_KEY=

################################################################################
# OAUTH 🟡 (required for social login buttons)
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
################################################################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

################################################################################
# FRONTEND CORS 🟢
################################################################################
FRONTEND_URL=http://localhost:3000

################################################################################
# SLA113 - INTERNAL OPERATOR OS 🟢
################################################################################
SLA113_ADMIN_KEY=dev-admin-key
SLA113_ENGINE_TIMEOUT=300
SLA113_LOG_LEVEL=info
SLA113_HEALTH_CHECK_INTERVAL=60

################################################################################
# EMPIRE1 - ENTERPRISE BUSINESS OS 🟡
################################################################################
EMPIRE1_API_KEY=
EMPIRE1_BILLING_RATE=0.01

################################################################################
# AI ENGINE INTEGRATIONS 🟡
################################################################################
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
EMERGENT_LLM_KEY=

################################################################################
# EMPIRE-1 ROUTER 🟡
# Route format: provider/model. Example free-compatible route:
# EMPIRE_ROUTER_MODEL=open_router/openrouter/free
################################################################################
EMPIRE_ROUTER_MODEL=
EMPIRE_ROUTER_FALLBACKS=
EMPIRE_ROUTER_MODELS=[]
EMPIRE_ROUTER_TOKEN=
EMPIRE_ROUTER_TIMEOUT_SECONDS=120

# Common hosted provider credentials
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
QWENCLOUD_API_KEY=
QWENCLOUD_CODING_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
SILICONFLOW_API_KEY=
NEBIUS_API_KEY=
CHUTES_API_KEY=
FEATHERLESS_API_KEY=
AGNES_API_KEY=
ZENMUX_API_KEY=
WANDB_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
CODESTRAL_API_KEY=
OPENCODE_API_KEY=
AI_GATEWAY_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_BASE_URL=
HUGGINGFACE_API_KEY=
COHERE_API_KEY=
GITHUB_MODELS_TOKEN=
WAFER_API_KEY=
KIMI_API_KEY=
KIMI_CODE_API_KEY=
MINIMAX_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
KILO_API_KEY=
FIREWORKS_API_KEY=
NOVITA_API_KEY=
ZAI_API_KEY=
TOKENROUTER_API_KEY=
NARAROUTE_API_KEY=
OLLAMA_API_KEY=

# Azure OpenAI-compatible route
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=

# Local OpenAI-compatible routes
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

################################################################################
# AZURE TTS (Voice King) 🟡
################################################################################
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_TTS_DEPLOYMENT=tts-hd

################################################################################
# ARCHISYNAPSE SETTLEMENT (VICS Micro-Royalty Ledger) 🟡
# Point to the running ArchiSynapse API for real transaction records.
# Defaults to http://localhost:3000/api/v1 if unset.
################################################################################
ARCHISYNAPSE_API_URL=http://localhost:3000/api/v1
ARCHISYNAPSE_API_KEY=

################################################################################
# BILLING & CREDITS 🟢
################################################################################
DEFAULT_CREDITS=100
BILLING_ENABLED=true
