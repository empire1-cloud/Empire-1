---
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
---

<PageLayout
  title="About Empire-1"
  description="Empire-1 AI Ecosystem — 245+ engines across gaming, music, payments, cultural intelligence, and creator economy."
>
  <Hero layout="centered" size="sm" showGrid>
    <Badge slot="badge" pill pulse class="bg-brand-500/20 text-brand-400 border-brand-500/30">Hybrid Intelligence Core</Badge>

    <h1 slot="title">
      <span class="text-brand-400">Empire-1</span> HIC
    </h1>

    <p slot="description">
      A full-stack AI ecosystem with 245+ engines across gaming, music, payments,
      and a pure-function evaluator — built for production.
    </p>
  </Hero>

  <section class="py-20 bg-surface-invert">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-on-invert mb-6">
        Architecture
      </h2>
      <p class="text-lg text-on-invert-secondary max-w-2xl mx-auto leading-relaxed">
        Each engine is a pluggable module. The AI Router classifies tasks by complexity
        and routes through a fallback chain: Primary &rarr; Fallback &rarr; Graceful Exit.
        Results are scored by the Evaluator Engine — no LLM calls, no side effects.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-display text-3xl md:text-4xl font-bold text-foreground mb-12 text-center">
        Engine Categories
      </h2>
      <div class="grid gap-8 md:grid-cols-3">
        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <span class="text-lg">&#9835;</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-foreground">Music &amp; Media</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                LYRICA 3 Soulfire — music generation, mixing, voice synthesis, beat making, and audio production pipeline.
              </p>
            </div>
          </div>
        </Card>

        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <span class="text-lg">&#9824;</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-foreground">Gaming &amp; Arcade</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Southern Arcade — fishing, slots, keno, payout settlement, tenant management, and RNG-secured gaming infrastructure.
              </p>
            </div>
          </div>
        </Card>

        <Card hover>
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-brand-500/20 to-brand-500/5 flex items-center justify-center text-brand-500 shrink-0">
              <span class="text-lg">&#36;</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-bold text-foreground">Payments &amp; Infrastructure</h3>
              <p class="text-sm text-foreground-muted leading-relaxed mt-1.5">
                Money pipeline, billing, subscriptions, revenue sharing, and payout settlement for creators and tenants.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
</PageLayout>
