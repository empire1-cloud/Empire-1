---
import EmpireHome from '../components/EmpireHome.tsx';

const apiBase = (import.meta.env.PUBLIC_API_URL || 'http://localhost:8001').replace(/\/+$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Empire-1 — Hybrid Intelligence Core</title>
    <meta
      name="description"
      content="245+ AI engines across gaming, music production, payments, cultural intelligence, and creator economy."
    />
    <meta name="theme-color" content="#050508" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://empire1.cloud/" />
    <meta property="og:title" content="Empire-1 — Hybrid Intelligence Core" />
    <meta
      property="og:description"
      content="245+ AI engines across gaming, music production, payments, cultural intelligence, and creator economy."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://empire1.cloud/" />
  </head>
  <body class="bg-[#050508] text-[#e0e0e0] antialiased">
    <script is:inline define:vars={{ apiBase }}>
      (() => {
        const originalFetch = window.fetch.bind(window);
        window.fetch = (input, init) => {
          try {
            const url = typeof input === 'string' ? input : input.url;
            if (url.startsWith('/api/crm/')) {
              return originalFetch(`${apiBase}${url}`, init);
            }
          } catch {
            // Fall through to the native fetch path.
          }
          return originalFetch(input, init);
        };
      })();
    </script>
    <EmpireHome client:load />
  </body>
</html>
